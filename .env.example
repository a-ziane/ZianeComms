NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only. Never prefix either of these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Optional legacy alternative: SUPABASE_SERVICE_ROLE_KEY=
# Public demo API is restricted to the synthetic zianecomms-demo facility.
ZIANECOMMS_DEMO_MODE=false

# Task 5: server-only Retell integration (disabled until configured)
RETELL_ENABLED=false
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_RULEBOOK=disaster
# Shared operator password (24+ characters). Browser HTTP Basic username: operator.
OPERATIONS_PASSWORD=
# 32 random bytes encoded as exactly 64 hexadecimal characters; back up securely.
CONTACT_ENCRYPTION_KEY=

# JSON object: concepts -> actual flat custom_analysis_data field names.
# Native Disaster fields/mapping: docs/retell-disaster-extraction.md (requested_service opts in).
RETELL_EXTRACTION_FIELDS=

# Task 6: server-only SMS recovery; unset/false disables all messaging.
TWILIO_ENABLED=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
# Account Auth Token is used only for official webhook signature validation.
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=
# Comma-separated E.164 numbers: only verified, consenting demo recipients (max 10).
SMS_RECOVERY_ALLOWED_RECIPIENTS=
# Optional per-mode template overrides for this single demo facility.
SMS_RECOVERY_DISASTER_TEXT=
SMS_RECOVERY_CLINIC_TEXT=
